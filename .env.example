# NASA FIRMS map key, used server-side only by app/api/firms/route.ts to pull
# near-real-time VIIRS/MODIS thermal detections for Lesvos.
#
# Request a free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Rate limit: 5000 transactions per 10-minute interval per key.
#
# On Vercel: Settings -> Environment Variables -> add FIRMS_MAP_KEY for
# Production, Preview, and Development, then redeploy.
#
# IMPORTANT: never rename this with a NEXT_PUBLIC_ prefix — that would embed
# the key in the client bundle and expose it to every visitor.
FIRMS_MAP_KEY=
